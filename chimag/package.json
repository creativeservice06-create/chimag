{
  "name": "chimag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Magazinul online chimag.ro – Cloudflare Workers + D1 + R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply chimag-db --local",
    "db:migrate": "wrangler d1 migrations apply chimag-db --remote",
    "db:seed:local": "wrangler d1 execute chimag-db --local --file=seed/seed.sql",
    "db:seed": "wrangler d1 execute chimag-db --remote --file=seed/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
